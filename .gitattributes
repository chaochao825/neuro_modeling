# New integrated projects and evidence snapshots use stable LF text.
local_plasticity_gated_dynamics/** text eol=lf
shared_dynamics_real_data/** text eol=lf
docs/** text eol=lf
integrations/** text eol=lf

# Root release metadata.
.gitignore text eol=lf
.gitattributes text eol=lf
README.md text eol=lf
REPRODUCE.md text eol=lf
METHODS_AND_RESULTS_ZH.md text eol=lf
NOTICE.md text eol=lf
pytest.ini text eol=lf

# Binary scientific figures are never text-normalized.
*.png binary
*.pdf binary
*.gz binary
*.mat binary
*.npy binary
*.npz binary

# Frozen evidence bundles are byte-attested; never rewrite their line endings.
local_plasticity_gated_dynamics/results/exp35_prefix_reliability_audit_retrospective_v2/** -text
local_plasticity_gated_dynamics/results/exp36_v1_invalid_schema_audit/** -text
local_plasticity_gated_dynamics/results/exp37_core50_change_aware_prefix_confirmation/** -text
local_plasticity_gated_dynamics/results/exp38_stream51_soft_memory_prospective_v1/** -text
